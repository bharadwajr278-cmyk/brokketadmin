{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(app.js|styles.css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "functions": {
    "api/reports.js": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "node_modules/pdfkit/js/standard-fonts/**"
    },
    "api/daily-report.js": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "node_modules/pdfkit/js/standard-fonts/**"
    }
  },
  "crons": [
    { "path": "/api/daily-report", "schedule": "30 2 * * *" }
  ]
}
